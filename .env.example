# Copy this file to `.env` and fill in the values below.
#   cp .env.example .env
# `.env` is gitignored — never commit it (it holds your cookie, API key, password).

# ============================================================
# REQUIRED
# ============================================================

# --- Finviz Elite screener (the "universe" of tickers to watch) ---
# Requires a Finviz Elite account. In Finviz, build a screener, then use its
# "export" URL. Log into elite.finviz.com and copy the export URL + your cookie.
ACTIVE_UNIVERSE_MODE=authorized_url
USE_CURL_IMPERSONATE=true
FINVIZ_ACTIVE_UNIVERSE_URL=https://elite.finviz.com/export?v=111&f=cap_nano,exch_nasd,sh_curvol_o100,sh_relvol_o1,ta_change_u&ft=4&o=-price
# Browser cookie for elite.finviz.com. In Chrome DevTools: Network tab -> reload
# -> click any elite.finviz.com request -> Request Headers -> copy the `Cookie:`
# value. (Cookies expire periodically; refresh when the universe stops updating.)
FINVIZ_COOKIE=paste_your_full_finviz_cookie_string_here

# --- Google Gemini (news sentiment) ---
# Get a key at https://aistudio.google.com/apikey . The free tier is only ~20
# requests/day; enable billing (pennies/month at this volume) for real use.
GEMINI_API_KEY=your_gemini_api_key

# ============================================================
# OPTIONAL — email alerts (Gmail SMTP)
# ============================================================
# Needs a Gmail App Password (Google Account -> Security -> 2-Step Verification
# -> App passwords). Then toggle "Email alert" on in the dashboard sidebar.
# ALERT_SMTP_USER=you@gmail.com
# ALERT_SMTP_PASSWORD=your_16_char_app_password

# ============================================================
# OPTIONAL — common tunables (defaults shown; uncomment to change)
# ============================================================
# APP_INTERVAL_SECONDS=90          # seconds between worker cycles
# APP_PIPELINE_TIMEOUT_SEC=120     # watchdog: force-kill a stalled pipeline
# DASHBOARD_PORT=8501              # Streamlit dashboard port
# ALERT_MIN_SCORE=0.5              # min sentiment score to alert
# ALERT_MIN_MATERIALITY=moderate   # routine | moderate | major
# TRAIL_STOP_PCT=0.30              # trailing stop (0.30 = 30% from peak)
# PROFIT_TARGET_PCT=50             # optional profit-target %, if enabled in dashboard
# EXIT_SMA_MINUTES=10              # smooth the exit price over N min (noise filter)
# CATASTROPHE_STOP_PCT=20          # hard raw-price exit if it crashes X% below peak
# STOP_CORROBORATION_MARGIN=0.03   # suppress a stop if Finviz is >X above it
# GEMINI_MODEL=gemini-2.5-flash
